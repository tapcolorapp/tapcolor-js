{
  "name": "@tapcolorapp/api",
  "version": "1.0.0",
  "description": "Official TypeScript/JavaScript client for the TapColor Developer API — browse coloring categories and collections.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tapcolor",
    "coloring",
    "coloring-pages",
    "api",
    "sdk",
    "rest",
    "kids",
    "client"
  ],
  "homepage": "https://developer.tapcolor.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapcolorapp/tapcolor-js.git"
  },
  "bugs": { "url": "https://tapcolor.app/contact/" },
  "author": "TapColor",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
